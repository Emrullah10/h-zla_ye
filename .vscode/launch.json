{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "🚀 Tüm Servisler",
      "configurations": [
        "service-auth (3001)",
        "service-courier (3002)",
        "service-onboarding (3003)",
        "service-admin (3004)",
        "service-gateway (4000)"
      ],
      "stopAll": true
    }
  ],
  "configurations": [
    {
      "name": "service-auth (3001)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/services/service-auth/main.js",
      "cwd": "${workspaceFolder}/services/service-auth",
      "envFile": "${workspaceFolder}/.env",
      "runtimeArgs": ["--experimental-vm-modules"],
      "console": "internalConsole",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "service-courier (3002)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/services/service-courier/main.js",
      "cwd": "${workspaceFolder}/services/service-courier",
      "envFile": "${workspaceFolder}/.env",
      "console": "internalConsole",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "service-onboarding (3003)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/services/service-onboarding/main.js",
      "cwd": "${workspaceFolder}/services/service-onboarding",
      "envFile": "${workspaceFolder}/.env",
      "console": "internalConsole",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "service-admin (3004)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/services/service-admin/main.js",
      "cwd": "${workspaceFolder}/services/service-admin",
      "envFile": "${workspaceFolder}/.env",
      "console": "internalConsole",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "service-gateway (4000)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/services/service-gateway/main.js",
      "cwd": "${workspaceFolder}/services/service-gateway",
      "envFile": "${workspaceFolder}/services/service-gateway/.env",
      "console": "internalConsole",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "hızla-web-app",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/hızla-web-app",
      "console": "internalConsole",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "hizla_mobile (macOS)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}/hizla_mobile",
      "deviceId": "macos",
      "args": ["--dart-define=API_BASE_URL=http://localhost:4000/api"]
    },
    {
      "name": "hizla_mobile (iOS Simulator)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}/hizla_mobile",
      "args": ["--dart-define=API_BASE_URL=http://localhost:4000/api"]
    },
    {
      "name": "hizla_mobile (Android Emulator)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}/hizla_mobile",
      "args": ["--dart-define=API_BASE_URL=http://10.0.2.2:4000/api"]
    },
    {
      "name": "hizla_mobile (Gerçek Cihaz - LAN)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}/hizla_mobile",
      "args": ["--dart-define=API_BASE_URL=http://192.168.1.6:4000/api"]
    }
  ]
}
